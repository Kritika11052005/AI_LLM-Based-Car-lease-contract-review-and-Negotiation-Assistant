{
  "apr": [
    {
      "condition": "missing",
      "severity": "high",
      "issue": "Interest rate not specified",
      "reason": "Hidden interest may increase total cost.",
      "negotiation_intent": "Request written APR disclosure"
    },
    {
      "condition": "< 3",
      "severity": "none",
      "issue": "Low APR",
      "reason": "Competitive interest rate.",
      "negotiation_intent": null
    },
    {
      "condition": "3 - 8",
      "severity": "medium",
      "issue": "Moderate APR",
      "reason": "Interest rate could be improved.",
      "negotiation_intent": "Request lower APR"
    },
    {
      "condition": "> 10",
      "severity": "high",
      "issue": "High APR",
      "reason": "Excessive interest rate.",
      "negotiation_intent": "Negotiate lower interest"
    }
  ],

  "lease_term_months": [
    {
      "condition": "missing",
      "severity": "medium",
      "issue": "Lease term not specified",
      "reason": "Lease duration is unclear.",
